# ── AYAZ production environment — single-VPS deployment ──────────────────────
# Copy this file to .env.prod and fill in every placeholder.
# NEVER commit .env.prod — it is listed in .gitignore.
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"  # JWT_SECRET
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"  # VAULT_KEY

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=ayaz
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=ayaz

# ── Backend secrets (REQUIRED — app refuses to start in production without these) ─
# Must be >= 32 characters and NOT the dev default "changeme".
JWT_SECRET=CHANGE_ME_min_32_char_random_hex

# 32-byte URL-safe base64 string (NOT the committed dev default).
VAULT_KEY=CHANGE_ME_urlsafe_base64_32bytes

# ── CORS — set to the public URL(s) of your frontend ────────────────────────
# Comma-separated list if you have more than one origin.
ALLOWED_ORIGINS=https://yourdomain.com

# ── Frontend build arg — public URL of the backend ───────────────────────────
# This is baked into the Next.js bundle at build time.
NEXT_PUBLIC_API_BASE=https://api.yourdomain.com

# ── Optional: port overrides ─────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── Optional: AI insights (leave empty to use template narrator) ──────────────
ANTHROPIC_API_KEY=

# ── Optional: billing (leave as "none" to use the stub provider) ─────────────
BILLING_PROVIDER=none
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
