# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test suite — exclude test code, but KEEP the fixtures the demo seed reads at
# runtime. scripts/seed_demo.py loads tests/fixtures/{sample_metrics.json,
# google_ads_search_stream.json,sample_feed.xml}; without them in the image the
# seed crashes with FileNotFoundError and SEED_DEMO yields an empty demo tenant.
# Single source of truth: the same fixtures the test-suite uses.
tests/*
!tests/fixtures

# Local databases (SQLite scratch)
*.db
*.sqlite
*.sqlite3

# Dev tooling
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Secrets / env files — never bake real values into the image
.env
.env.*
!.env.example

# Git
.git/
.gitignore

# Editor / OS
.idea/
.vscode/
*.DS_Store
