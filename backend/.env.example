# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://ayaz:ayaz@localhost:5432/ayaz

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-generate-a-real-secret-before-deploy
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Vault (HashiCorp) ─────────────────────────────────────────────────────────
# TODO (Faz 1): wire real Vault; for now connector tokens are not stored
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root

# ── Billing ───────────────────────────────────────────────────────────────────
# TODO (Faz 1): iyzico + Stripe keys go here — never commit real values
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
